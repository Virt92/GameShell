<Window x:Class="GameShell.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameShell"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#0a0a0a">

    <Grid>
        <!-- Lock Screen (shown when not logged in) -->
        <Grid x:Name="LockScreen" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="400">
                <!-- Logo -->
                <TextBlock Text="GameShell"
                           FontSize="48" FontWeight="Bold"
                           Foreground="#22c55e"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40" />

                <!-- Phone login -->
                <TextBlock Text="Вхід за номером телефону"
                           Foreground="#9ca3af" FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <TextBox x:Name="PhoneInput"
                         Style="{StaticResource GameShellTextBox}"
                         Tag="+380..."
                         Margin="0,0,0,12" />

                <Button Content="Отримати SMS-код"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnSendSmsClick"
                        Margin="0,0,0,24" />

                <!-- Separator -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="#374151" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="або" Foreground="#6b7280" Margin="16,0" />
                    <Border Grid.Column="2" Height="1" Background="#374151" VerticalAlignment="Center" />
                </Grid>

                <!-- QR Code -->
                <Button Content="Увійти через QR-код"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,0,12" />

                <!-- Guest -->
                <Button Content="Продовжити як гість"
                        Style="{StaticResource GhostButton}"
                        Click="OnGuestClick" />
            </StackPanel>
        </Grid>

        <!-- Game Launcher (shown when logged in) -->
        <Grid x:Name="GameLauncher" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />   <!-- Top bar: timer, balance -->
                <RowDefinition Height="*" />     <!-- Games grid -->
                <RowDefinition Height="60" />    <!-- Bottom bar: shop, settings -->
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="#1f2937" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="GameShell"
                               FontSize="20" FontWeight="Bold" Foreground="#22c55e"
                               VerticalAlignment="Center" />

                    <!-- Search -->
                    <TextBox Grid.Column="1"
                             Style="{StaticResource GameShellTextBox}"
                             Tag="Пошук ігор..."
                             Margin="40,10,40,10" />

                    <!-- Timer & Balance -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerDisplay"
                                   Text="02:45:00"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#facc15"
                                   Margin="0,0,20,0" />
                        <TextBlock x:Name="BalanceDisplay"
                                   Text="150 ₴"
                                   FontSize="16" Foreground="#9ca3af"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Games Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <ItemsControl x:Name="GamesGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="#111827" BorderBrush="#1f2937" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🛒 Магазин" Style="{StaticResource GhostButton}" Margin="0,0,12,0" />
                        <Button Content="🏆 Досягнення" Style="{StaticResource GhostButton}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="⚙ Налаштування"
                            Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Notification overlay -->
        <Border x:Name="NotificationOverlay"
                Visibility="Collapsed"
                Background="#00000080"
                VerticalAlignment="Top"
                Padding="20">
            <Border Background="#1e293b" CornerRadius="12" Padding="20" HorizontalAlignment="Center">
                <TextBlock x:Name="NotificationText"
                           FontSize="18" Foreground="#fbbf24"
                           HorizontalAlignment="Center" />
            </Border>
        </Border>
    </Grid>
</Window>
