generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================
// CLUBS (мультитенант)
// ========================

model Club {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  address     String?
  timezone    String   @default("Europe/Kyiv")
  logoUrl     String?  @map("logo_url")
  shellBgUrl  String?  @map("shell_bg_url")
  shellColors Json     @default("{}") @map("shell_colors")
  settings    Json     @default("{}") 
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff       Staff[]
  players     Player[]
  zones       Zone[]
  hosts       Host[]
  tariffs     Tariff[]
  sessions    Session[]
  games       Game[]
  products    Product[]
  orders      Order[]
  shifts      Shift[]
  achievements Achievement[]
  promoCodes  PromoCode[]
  deployTasks DeployTask[]

  @@map("clubs")
}

// ========================
// STAFF (персонал)
// ========================

enum StaffRole {
  owner
  devops
  operator
  accountant
}

model Staff {
  id           String    @id @default(uuid())
  clubId       String    @map("club_id")
  email        String?
  phone        String?
  name         String
  role         StaffRole
  pinCode      String?   @map("pin_code")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  club         Club      @relation(fields: [clubId], references: [id])
  sessions     Session[] @relation("SessionOperator")
  shifts       Shift[]
  deployTasks  DeployTask[]

  @@unique([clubId, email])
  @@map("staff")
}

// ========================
// PLAYERS (гості)
// ========================

enum LoyaltyLevel {
  bronze
  silver
  gold
  platinum
}

model Player {
  id           String       @id @default(uuid())
  clubId       String       @map("club_id")
  phone        String?
  nickname     String?
  avatarUrl    String?      @map("avatar_url")
  balance      Decimal      @default(0) @db.Decimal(10, 2)
  bonusPoints  Int          @default(0) @map("bonus_points")
  loyaltyLevel LoyaltyLevel @default(bronze) @map("loyalty_level")
  totalHours   Decimal      @default(0) @db.Decimal(10, 1) @map("total_hours")
  totalSpent   Decimal      @default(0) @db.Decimal(10, 2) @map("total_spent")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  club         Club         @relation(fields: [clubId], references: [id])
  sessions     Session[]
  orders       Order[]

  @@unique([clubId, phone])
  @@map("players")
}

// ========================
// ZONES (зони залу)
// ========================

model Zone {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  name      String
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  club      Club     @relation(fields: [clubId], references: [id])
  hosts     Host[]
  tariffs   Tariff[]

  @@map("zones")
}

// ========================
// HOSTS (ПК та консолі)
// ========================

enum HostType {
  pc
  ps5
  ps4
  ps2
  xbox
  switch_console @map("switch")
}

enum HostStatus {
  online
  offline
  busy
  maintenance
  booked
}

enum ControlMethod {
  agent
  playactor
  tasmota
  manual
}

model Host {
  id            String        @id @default(uuid())
  clubId        String        @map("club_id")
  zoneId        String?       @map("zone_id")
  name          String
  type          HostType
  status        HostStatus    @default(offline)
  macAddress    String?       @map("mac_address")
  ipAddress     String?       @map("ip_address")
  hostname      String?
  hardware      Json?
  controlMethod ControlMethod @default(manual) @map("control_method")
  tasmotaIp     String?       @map("tasmota_ip")
  tasmotaTopic  String?       @map("tasmota_topic")
  cecDeviceId   String?       @map("cec_device_id")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  club          Club          @relation(fields: [clubId], references: [id])
  zone          Zone?         @relation(fields: [zoneId], references: [id])
  sessions      Session[]
  hostGames     HostGame[]
  orders        Order[]
  telemetry     HostTelemetry[]

  @@map("hosts")
}

// ========================
// TARIFFS (тарифи)
// ========================

enum TariffType {
  hourly
  fixed
  daily
}

model Tariff {
  id        String     @id @default(uuid())
  clubId    String     @map("club_id")
  zoneId    String?    @map("zone_id")
  name      String
  type      TariffType
  price     Decimal    @db.Decimal(10, 2)
  duration  Int?       // minutes for fixed
  appliesTo String     @default("pc") @map("applies_to")
  timeFrom  String?    @map("time_from")
  timeTo    String?    @map("time_to")
  dayOfWeek Int[]      @map("day_of_week")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  club      Club       @relation(fields: [clubId], references: [id])
  zone      Zone?      @relation(fields: [zoneId], references: [id])
  sessions  Session[]

  @@map("tariffs")
}

// ========================
// SESSIONS (сесії)
// ========================

enum SessionType {
  prepaid
  postpaid
}

enum SessionStatus {
  active
  paused
  completed
  cancelled
}

enum PaymentMethod {
  cash
  card
  balance
  bonus
}

model Session {
  id            String         @id @default(uuid())
  clubId        String         @map("club_id")
  hostId        String         @map("host_id")
  playerId      String?        @map("player_id")
  tariffId      String?        @map("tariff_id")
  operatorId    String?        @map("operator_id")
  type          SessionType
  status        SessionStatus  @default(active)
  startedAt     DateTime       @default(now()) @map("started_at")
  pausedAt      DateTime?      @map("paused_at")
  endedAt       DateTime?      @map("ended_at")
  durationMin   Int?           @map("duration_min")
  actualMin     Int?           @map("actual_min")
  amount        Decimal?       @db.Decimal(10, 2)
  paymentMethod PaymentMethod? @map("payment_method")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  club          Club           @relation(fields: [clubId], references: [id])
  host          Host           @relation(fields: [hostId], references: [id])
  player        Player?        @relation(fields: [playerId], references: [id])
  tariff        Tariff?        @relation(fields: [tariffId], references: [id])
  operator      Staff?         @relation("SessionOperator", fields: [operatorId], references: [id])

  @@map("sessions")
}

// ========================
// SHIFTS (зміни)
// ========================

enum ShiftStatus {
  open
  closed
}

model Shift {
  id          String      @id @default(uuid())
  clubId      String      @map("club_id")
  operatorId  String      @map("operator_id")
  startedAt   DateTime    @map("started_at")
  endedAt     DateTime?   @map("ended_at")
  cashStart   Decimal     @default(0) @db.Decimal(10, 2) @map("cash_start")
  cashEnd     Decimal?    @db.Decimal(10, 2) @map("cash_end")
  revenue     Decimal     @default(0) @db.Decimal(10, 2)
  status      ShiftStatus @default(open)
  createdAt   DateTime    @default(now()) @map("created_at")

  club        Club        @relation(fields: [clubId], references: [id])
  operator    Staff       @relation(fields: [operatorId], references: [id])

  @@map("shifts")
}

// ========================
// GAMES (ігри)
// ========================

model Game {
  id         String     @id @default(uuid())
  clubId     String     @map("club_id")
  name       String
  slug       String?
  category   String?
  launcher   String?
  launcherId String?    @map("launcher_id")
  exePath    String?    @map("exe_path")
  coverUrl   String?    @map("cover_url")
  sizeGb     Decimal?   @db.Decimal(5, 1) @map("size_gb")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  club       Club       @relation(fields: [clubId], references: [id])
  hostGames  HostGame[]
  deployTasks DeployTask[]

  @@map("games")
}

model HostGame {
  hostId      String   @map("host_id")
  gameId      String   @map("game_id")
  version     String?
  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  status      String   @default("installed")

  host        Host     @relation(fields: [hostId], references: [id])
  game        Game     @relation(fields: [gameId], references: [id])

  @@id([hostId, gameId])
  @@map("host_games")
}

// ========================
// SHOP (магазин)
// ========================

model Product {
  id        String      @id @default(uuid())
  clubId    String      @map("club_id")
  name      String
  category  String?
  price     Decimal     @db.Decimal(10, 2)
  imageUrl  String?     @map("image_url")
  inStock   Boolean     @default(true) @map("in_stock")
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")

  club      Club        @relation(fields: [clubId], references: [id])
  orderItems OrderItem[]

  @@map("products")
}

enum OrderStatus {
  new_order @map("new")
  preparing
  ready
  delivered
  cancelled
}

model Order {
  id            String        @id @default(uuid())
  clubId        String        @map("club_id")
  playerId      String?       @map("player_id")
  hostId        String?       @map("host_id")
  status        OrderStatus   @default(new_order)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod? @map("payment_method")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  club          Club          @relation(fields: [clubId], references: [id])
  player        Player?       @relation(fields: [playerId], references: [id])
  host          Host?         @relation(fields: [hostId], references: [id])
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ========================
// LOYALTY (лояльність)
// ========================

model Achievement {
  id          String   @id @default(uuid())
  clubId      String   @map("club_id")
  name        String
  description String?
  iconUrl     String?  @map("icon_url")
  condition   Json
  rewardPoints Int     @default(0) @map("reward_points")
  createdAt   DateTime @default(now()) @map("created_at")

  club        Club     @relation(fields: [clubId], references: [id])

  @@map("achievements")
}

model PromoCode {
  id        String    @id @default(uuid())
  clubId    String    @map("club_id")
  code      String    @unique
  type      String
  value     Decimal   @db.Decimal(10, 2)
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  club      Club      @relation(fields: [clubId], references: [id])

  @@map("promo_codes")
}

// ========================
// DEPLOY TASKS (завдання встановлення)
// ========================

enum DeployAction {
  install
  update
  uninstall
}

enum DeployStatus {
  queued
  running
  completed
  failed
}

model DeployTask {
  id          String       @id @default(uuid())
  clubId      String       @map("club_id")
  gameId      String       @map("game_id")
  action      DeployAction
  targetHosts String[]     @map("target_hosts")
  status      DeployStatus @default(queued)
  progress    Json         @default("{}")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  club        Club         @relation(fields: [clubId], references: [id])
  game        Game         @relation(fields: [gameId], references: [id])
  createdBy   Staff?       @relation(fields: [createdById], references: [id])

  @@map("deploy_tasks")
}

// ========================
// TELEMETRY (телеметрія)
// ========================

model HostTelemetry {
  id         BigInt   @id @default(autoincrement())
  hostId     String   @map("host_id")
  cpuUsage   Int?     @map("cpu_usage")
  gpuUsage   Int?     @map("gpu_usage")
  ramUsage   Int?     @map("ram_usage")
  cpuTemp    Int?     @map("cpu_temp")
  gpuTemp    Int?     @map("gpu_temp")
  diskUsage  Json?    @map("disk_usage")
  recordedAt DateTime @default(now()) @map("recorded_at")

  host       Host     @relation(fields: [hostId], references: [id])

  @@map("host_telemetry")
}
